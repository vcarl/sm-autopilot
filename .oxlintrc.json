{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-assertions": [
      "error",
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/ban-ts-comment": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "src/test-support/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/consistent-type-assertions": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/ban-ts-comment": "off"
      }
    },
    {
      "files": [
        "src/alerts.ts",
        "src/bridge.ts",
        "src/heartbeat.ts",
        "src/journal-webhook.ts",
        "src/play/combat/bounties/bounties.ts",
        "src/play/combat/bounties/index.ts",
        "src/play/combat/hunting.ts",
        "src/play/combat/index.ts",
        "src/play/combat/salvage.ts",
        "src/play/fleet/fleet.ts",
        "src/play/fleet/index.ts",
        "src/play/freighter/host.ts",
        "src/play/freighter/index.ts",
        "src/play/hangar.ts",
        "src/play/hauling/freight.ts",
        "src/play/hauling/index.ts",
        "src/play/hauling/passengers.ts",
        "src/play/industry/crafting.ts",
        "src/play/industry/index.ts",
        "src/play/market.ts",
        "src/play/menu.ts",
        "src/play/mining/index.ts",
        "src/play/mining/mining.ts",
        "src/play/missions.ts",
        "src/play/orient.ts",
        "src/play/rest.ts",
        "src/play/storage.ts",
        "src/play/trading/index.ts",
        "src/play/trading/scout.ts",
        "src/play/trading/trading.ts",
        "src/play/travel.ts",
        "src/readiness.ts",
        "src/response-details.ts",
        "src/run.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/consistent-type-assertions": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/ban-ts-comment": "off"
      }
    }
  ]
}
