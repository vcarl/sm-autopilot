// pilot/index.ts — the one file you play by writing. spacemolt_run executes `main`.
// This run only looks: where the ship is, what it holds, and every skill's level.
import {orient, note} from 'play';

export default async function main() {
  const look = await orient();
  for (const [skill, progress] of Object.entries(look.detail.present.skills))
    note(`${skill} level ${progress.level}`);
  return look;
}
